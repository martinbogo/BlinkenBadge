{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlinkenBadge",
  "version": "1.0.41",
  "identifier": "com.martin.blinkenbadge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlinkenBadge",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["badge"],
        "name": "BlinkenBadgeProject",
        "description": "BlinkenBadge project",
        "role": "Editor",
        "mimeType": "application/x-blinkenbadge-project"
      },
      {
        "ext": ["badgemsg"],
        "name": "BlinkenBadgeMessage",
        "description": "BlinkenBadge message",
        "role": "Editor",
        "mimeType": "application/x-blinkenbadge-message"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
