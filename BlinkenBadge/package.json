{
  "name": "blinkenbadge",
  "private": true,
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "BADGE_TARGET=web vite --port 5180",
    "build:web": "tsc && BADGE_TARGET=web vite build --outDir dist-web",
    "build:ios": "tsc && TAURI_ENV_PLATFORM=ios vite build --outDir dist-ios",
    "build:android": "tsc && TAURI_ENV_PLATFORM=android vite build --outDir dist-android"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/web-bluetooth": "^0.0.21",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "description": "Animation editor for 44x11 monochrome LED name badges (WCH CH582)",
  "license": "Apache-2.0",
  "author": "Martin Bogomolni",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinbogo/blinkenbadge.git"
  },
  "engines": {
    "node": ">=24"
  }
}
