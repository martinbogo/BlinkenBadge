# WCH CH582 LED badge, stock firmware, vendor-defined HID interface.
#
# Grants non-root userspace access to the USB HID interface.
#
# Installation:
#   sudo cp 99-led-badge.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Disconnect and reconnect the USB cable after reloading rules.

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5020", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5020", MODE="0660", TAG+="uaccess"
